# Cloudflare Worker that handles contact form submissions for all portals.
# Production: https://support-email-worker.rubrion.workers.dev/submit
# Local dev: `wrangler dev` inside support-email-worker/ exposes http://localhost:8787/submit
VITE_SUPPORT_WORKER_URL=

# Cloudflare Turnstile site key. The same site key serves all portals as long
# as each domain is in the Turnstile widget's hostname allow-list.
# Leave empty to disable the captcha widget locally.
VITE_TURNSTILE_SITE_KEY=

# (Existing) Base URL for the media bucket — already used by Hero/Projects.
# VITE_MEDIA_BASE_URL=https://media.samuelrubens.com
